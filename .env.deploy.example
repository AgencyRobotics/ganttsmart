# Copy this file to `.env.deploy` and fill in real values, then run ./deploy.sh
# `.env.deploy` is gitignored. All VITE_* values are baked into the public
# client bundle at build time, so they are not secrets — but keep this file
# out of version control anyway.

# --- Where to deploy (the Lightsail instance) ---
# Either an SSH config Host alias (e.g. "ganttsmart") or "ubuntu@<ip>".
DEPLOY_SSH_HOST=ganttsmart
# Directory on the instance where the project is synced and built.
DEPLOY_REMOTE_DIR=/home/ubuntu/ganttsmart

# --- App build-time config (inlined into the bundle by Vite) ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_LINEAR_CLIENT_ID=your-linear-oauth-client-id
# Must match the domain users hit + your Linear OAuth app + Supabase redirect allowlist.
VITE_LINEAR_REDIRECT_URI=https://gantt.agencyrobotics.com/callback
# Set to true to redirect / → /app (login) instead of the marketing landing page.
VITE_SKIP_LANDING=true
